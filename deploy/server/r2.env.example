# Configure the bucket's custom domain before running configure-r2.py.
# Docker loads data/r2.env with format: raw; values are not shell-expanded.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=YOUR_BUCKET
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://YOUR_CUSTOM_IMAGE_DOMAIN
R2_KEY_PREFIX=aistudio/images
